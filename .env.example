# =============================================================================
# Research Gap Hunter — environment configuration
#
# Copy to .env for local development:   cp .env.example .env
# .env is gitignored. Never commit real credentials.
#
# Deployment: these are set in the Render service's Environment tab (or
# prompted by render.yaml), not in a file. See DEPLOYMENT.md for where each
# value comes from.
# =============================================================================


# -----------------------------------------------------------------------------
# Deployment mode
# -----------------------------------------------------------------------------
# false (default) — local development. /ingest and /explain enabled, Ollama
#                   used for both, CORS open so a dev frontend on any port works.
# true            — public deployment. /ingest and /explain refuse with 403, so
#                   no Ollama is needed anywhere; CORS restricted to
#                   ALLOWED_ORIGINS.
#
# PRODUCTION MUST SET THIS TO true. There is deliberately no hosted-LLM
# fallback: a per-request paid API call for anonymous callers is an open-ended
# cost, and that path was removed on purpose.
DEMO_MODE=false

# Comma-separated origins allowed to call the API. Only consulted when
# DEMO_MODE=true. Leaving it unset in demo mode allows NO origins — a closed
# door rather than a silent fallback to "*", so a misconfigured deploy fails
# visibly in the browser instead of quietly serving the whole internet.
# Production example:
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=


# -----------------------------------------------------------------------------
# Neo4j — local Desktop, or AuraDB in production
# -----------------------------------------------------------------------------
# Local (Neo4j Desktop):     bolt://localhost:7687
# AuraDB:                    neo4j+s://<dbid>.databases.neo4j.io
#                            (note the +s — AuraDB requires TLS)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# The Neo4j Desktop *instance* name (rgh-mvp) is NOT the database name.
#
# Locally the database is "neo4j". On Aura it may not be: instances created
# recently name the database after the instance id (e.g. "ca34cbce") rather than
# "neo4j", and using the wrong name fails at routing rather than at auth, with
# "Unable to get a routing table for database 'neo4j'".
#
# Read the real name from the instance:
#   MATCH (n) RETURN 1                      -- run against the `system` database:
#   SHOW DATABASES                          -- take the row whose type is "standard"
NEO4J_DATABASE=neo4j


# -----------------------------------------------------------------------------
# Qdrant — local Docker, or Qdrant Cloud in production
# -----------------------------------------------------------------------------
# QDRANT_URL takes precedence when set, and is what a managed instance needs:
# an HTTPS URL plus an API key. Host/port alone cannot reach Qdrant Cloud.
# Cloud example:  https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# Local Docker fallback, used only when QDRANT_URL is empty.
QDRANT_HOST=localhost
QDRANT_PORT=6333


# -----------------------------------------------------------------------------
# SQLite paper store
# -----------------------------------------------------------------------------
# Where data/papers.db lives. Leave unset locally.
#
# On a platform WITH a persistent disk, point this at the mount so the corpus
# survives a redeploy — e.g. PAPERS_DB_PATH=/data/papers.db. The parent
# directory is created automatically, so a freshly mounted empty volume needs no
# provisioning.
#
# The current deployment target (Render free) has no disk, and deliberately does
# not ask for one: SQLite is rebuilt from Neo4j on every boot by the self-heal
# below. Neo4j is already the source of truth for scoring, so treating SQLite as
# a derived cache is the honest arrangement there rather than a workaround.
PAPERS_DB_PATH=

# Safety net for the above. On startup the API compares Neo4j Paper nodes to
# SQLite rows and rebuilds any missing rows from graph relationships — no LLM,
# no network, deterministic. It only ever adds rows; it never overwrites an
# existing row and never deletes anything.
#
# Leave this on. On a platform with a disk, its WARNING is your signal that the
# volume did not work. On Render free there is no disk by design, so the WARNING
# is routine and simply means the container restarted.
SELFHEAL_ON_STARTUP=true


# -----------------------------------------------------------------------------
# Ollama — local only
# -----------------------------------------------------------------------------
# Used by /ingest (extraction) and /explain (hypothesis explanation). Both are
# refused when DEMO_MODE=true, so a public deployment never contacts Ollama and
# these two values are irrelevant there.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------------------
# Semantic Scholar — ingestion only
# -----------------------------------------------------------------------------
# Optional. Unauthenticated is 1 req/sec; a key raises it to 10 req/sec.
# Only used by the ingestion path, which is disabled in demo mode.
SEMANTIC_SCHOLAR_API_KEY=


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Root log level, configured once at the API entrypoint. INFO is what you want
# in production: it is the level at which the startup paper-store
# reconciliation reports, and the WARNING it raises when it has to rebuild rows
# is your signal that PAPERS_DB_PATH is not actually persistent.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# API rate limiting
# -----------------------------------------------------------------------------
# In-process token buckets, keyed by peer address and cost tier. Set to false
# only for local debugging.
#
# State is per-process and in-memory, so limits multiply by worker count —
# run a single worker in production (see G5 in PROJECT_HARDENING_PLAN.md).
RATE_LIMIT_ENABLED=true
