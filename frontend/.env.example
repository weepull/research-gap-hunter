# =============================================================================
# Frontend environment — Next.js
#
# Local:  cp .env.example .env.local
# Vercel: set this in Project Settings -> Environment Variables, for every
#         environment you intend to build (Production, Preview, Development).
# =============================================================================

# The FastAPI backend's public base URL. No trailing slash.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime. If this
# is missing from the Vercel build environment the production build FAILS ON
# PURPOSE (frontend/lib/api.ts) — otherwise the deployed bundle would ship
# "http://localhost:8000" baked in and every request would fail in the browser
# with no server-side error to notice.
#
# Local:      http://localhost:8000
# Production: https://<your-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
